# Required for every browser-use evaluation process.
# These values override browser-use defaults and must not be removed.
ANONYMIZED_TELEMETRY=false
BROWSER_USE_CLOUD_SYNC=false

# Supply only at approved model-runtime invocation; never commit a real value.
# experiment.yaml defaults to the OpenAI-compatible endpoint and OPENAI_API_KEY.
# OPENAI_API_KEY=
# The standalone legacy micro-pilot reads OPENROUTER_API_KEY instead.
# OPENROUTER_API_KEY=

# Chromium 151 for the reference and Playwright MCP arms.
# Linux example:
# BROWSER_EVAL_CHROMIUM=/home/user/.cache/ms-playwright/chromium-1234/chrome-linux/chrome
# macOS example:
# BROWSER_EVAL_CHROMIUM=/Users/user/Library/Caches/ms-playwright/chromium-1234/chrome-mac/Chromium.app/Contents/MacOS/Chromium
# Chromium 140 for browser-use 0.13.8 on ARM64.
# Linux example:
# BROWSER_EVAL_BROWSER_USE_CHROMIUM=/home/user/.cache/ms-playwright/chromium-1187/chrome-linux/chrome
# macOS example:
# BROWSER_EVAL_BROWSER_USE_CHROMIUM=/Users/user/Library/Caches/ms-playwright/chromium-1187/chrome-mac/Chromium.app/Contents/MacOS/Chromium

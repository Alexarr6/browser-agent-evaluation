# Required for every browser-use evaluation process.
# These values override browser-use defaults and must not be removed.
ANONYMIZED_TELEMETRY=false
BROWSER_USE_CLOUD_SYNC=false

# Supply only at approved model-runtime invocation; never commit a real value.
# experiment.yaml defaults to the OpenAI-compatible endpoint and OPENAI_API_KEY.
# OPENAI_API_KEY=
# The standalone legacy micro-pilot reads OPENROUTER_API_KEY instead.
# OPENROUTER_API_KEY=

# Chromium 151 for the reference and Playwright MCP arms.
# BROWSER_EVAL_CHROMIUM=/absolute/path/to/chromium-151/chrome
# Chromium 140 for browser-use 0.13.8 on ARM64.
# BROWSER_EVAL_BROWSER_USE_CHROMIUM=/absolute/path/to/chromium-140/chrome
